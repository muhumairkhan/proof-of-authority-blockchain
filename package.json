{
  "name": "poa-blockchain-ts",
  "version": "1.0.0",
  "description": "Minimal Proof-of-Authority blockchain in TypeScript",
  "main": "dist/node.js",
  "scripts": {
    "build": "tsc",
    "generate-keys": "ts-node scripts/generate-keys.ts",
    "reset": "ts-node scripts/reset.ts",
    "start": "ts-node scripts/start.ts",
    "node1": "cross-env VALIDATOR_INDEX=0 ts-node src/node.ts",
    "node2": "cross-env VALIDATOR_INDEX=1 ts-node src/node.ts",
    "node3": "cross-env VALIDATOR_INDEX=2 ts-node src/node.ts",
    "fullnode": "cross-env API_PORT=3099 P2P_PORT=6099 ts-node src/node.ts",
    "wallet": "ts-node scripts/wallet.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}