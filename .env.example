# Encrypts/decrypts validator private keys at rest (AES-256-GCM via scrypt).
VALIDATOR_KEY_PASSPHRASE=dev-only-change-me

# Number of validator keypairs to generate — must match how many validator
# nodes you plan to run (can run 3 node setup node1/node2/node3).
NUM_VALIDATORS=3

# Time slot available for each validator to propose block
BLOCK_TIMEOUT_MS=15000

# Min time to wait before proposing block (used for pending tx to fll mempool)
SLOT_WAIT_MS=3000